# Virasat Atlas - Root Apache Configuration for InfinityFree / cPanel (htdocs)
RewriteEngine On
RewriteBase /

# 1. Protect sensitive configuration files
<FilesMatch "^\.env|.*\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Prevent rewrite loop for api entry point
RewriteRule ^api/index\.php$ - [L]

# 3. Route any /api/* or /api/v1/* requests directly to api/index.php
RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# 4. Serve existing files or directories directly (CSS, JS, images, installer, test scripts)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. SPA Client Routing: Send all remaining route paths to React index.html
RewriteRule ^ index.html [L]

# 6. Proper MIME Types
AddType image/svg+xml .svg .svgz
AddType application/javascript .js
AddType text/css .css

